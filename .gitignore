# 构建产物：前端的 dist/ 和 k8s-ops 的 dist/ 都靠这一条，别把它当 Python 残留删掉
dist/
build/
backend-java/target/

# backend-java/scripts/*.py 仍被 Java 调用，导入时会产生字节码缓存
__pycache__/
*.py[cod]

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# 运行期数据与依赖
backend-java/data/
backend-java/.m2/
node_modules/

# 前端测试与构建缓存
frontend/playwright-report/
frontend/test-results/
frontend/.vite/

# Logs
*.log
